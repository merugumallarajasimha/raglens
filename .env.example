# RAGLens environment configuration
# Copy to .env and adjust values as needed

# ── Server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=raglens
POSTGRES_USER=raglens
POSTGRES_PASSWORD=raglens

# ── Qdrant ───────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=raglens_chunks

# ── Ollama / LLM ─────────────────────────────────────────────────────────
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120.0

# ── Embeddings ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_DIM=384
EMBEDDING_CACHE_DIR=data/embeddings_cache

# ── Reranker ─────────────────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_PROVIDER=sentence_transformers

# ── Retrieval ────────────────────────────────────────────────────────────
DENSE_TOP_K=20
SPARSE_TOP_K=20
HYBRID_TOP_K=20
RERANK_TOP_K=5
RRF_K=60
DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.5

# ── Chunking ─────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=120
CHUNKING_STRATEGY=section_aware

# ── Query Processing ─────────────────────────────────────────────────────
ENABLE_QUERY_REWRITE=true
MAX_RETRIEVAL_RETRIES=2
MIN_RERANK_SCORE=0.0
